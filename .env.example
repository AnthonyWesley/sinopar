# Endereço público do site (canonical, Open Graph e dados estruturados)
SITE_URL=https://sinopar.colettogroup.com

# WhatsApp da loja (lido no build: as páginas são pré-renderizadas), só dígitos com DDI e DDD (ex.: 5566XXXXXXXXX).
# Vazio = os botões de WhatsApp somem e o contato vai para /contato.
WHATSAPP_NUMBER=

# Asaas (pagamentos). Vazio = checkout em modo demonstração (pedido simulado, nada é cobrado).
ASAAS_API_KEY=
ASAAS_API_URL=https://sandbox.asaas.com/api/v3
