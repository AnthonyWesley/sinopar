# Endereço público do site (canonical, Open Graph e dados estruturados)
SITE_URL=https://sinopar.colettogroup.com

# WhatsApp da loja (lido no build: as páginas são pré-renderizadas), só dígitos com DDI e DDD (ex.: 5566XXXXXXXXX).
# Vazio = os botões de WhatsApp somem e o contato vai para /contato.
WHATSAPP_NUMBER=

# Asaas (pagamentos). Vazio = checkout em modo demonstração (pedido simulado, nada é cobrado).
ASAAS_API_KEY=
ASAAS_API_URL=https://sandbox.asaas.com/api/v3

# Token do webhook do Asaas: o mesmo texto vai no campo "Token de autenticação" do webhook no
# painel do Asaas (cabeçalho asaas-access-token). Vazio = o webhook recusa tudo (401).
ASAAS_WEBHOOK_TOKEN=

# Pasta do banco SQLite (site.db), das fotos enviadas (uploads/) e das cópias diárias (backups/).
# No Docker é /data (já definido no Dockerfile; monte um volume nela). Vazio = ./data.
DATA_DIR=

# Responsável (dono) do painel /admin, criado só na primeira subida, quando ainda não há nenhum.
# A senha é temporária: o painel exige trocar no primeiro acesso. Depois disso estas duas
# variáveis não são mais lidas (troque a senha pelo painel, não por aqui).
ADMIN_EMAIL=
ADMIN_PASSWORD=
